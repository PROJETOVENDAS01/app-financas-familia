# Evolution API (URL da SUA instância)
EVOLUTION_URL=https://sua-evolution.exemplo.com
EVOLUTION_AUTH_TYPE=apikey
EVOLUTION_TOKEN=
WHATSAPP_NUMBER=

# Claude
CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5

# Números autorizados a lançar (só dígitos, separados por vírgula)
ALLOWED_NUMBERS=
# Opcional: de quem é cada número (nome igual ao do dashboard). Ex: 5521964225920=THIAGO BONI,5521979838439=CAROL BONI
MEMBROS_WHATSAPP=
# Opcional: hora (0-23, horário de Brasília) a partir da qual o aviso das contas fixas do dia é enviado. Padrão: 8
HORA_AVISO=8

# Notificações do banco (celular Android). Um token por celular, com o nome do membro igual ao do dashboard.
# Ex: NOTIF_TOKENS=gere-um-token-longo-1=THIAGO BONI,gere-um-token-longo-2=CAROL BONI
NOTIF_TOKENS=
# Opcional: instituições cujo dinheiro recebido (ex.: comissões) entra SEMPRE como receita. Formato: NOME NA NOTIFICAÇÃO=descrição do lançamento
# Ex: NOTIF_ENTRADAS=HAPVIDA=Comissão Hapvida,AMIL=Comissão Amil
NOTIF_ENTRADAS=

# Servidor
PORT=3000
# DATA_DIR=/data   # pasta do volume persistente no deploy

# Chave de acesso do app e da API (gere uma aleatória e longa)
API_KEY=
